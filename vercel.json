{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "go": {
      "root": "server",
      "framework": "go"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "go" } },
    { "source": "/auth/(.*)", "destination": { "service": "go" } },
    { "source": "/p/:owner/:repo/faq", "destination": { "service": "go" } },
    { "source": "/p/:owner/:repo/faq/:slug", "destination": { "service": "go" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
