{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "slice/*": false
    }
  },
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": "web",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "go": {
      "root": "server",
      "framework": "go"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</hero-meadow.webp>; rel=preload; as=image; fetchpriority=high"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "go"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "go"
      }
    },
    {
      "source": "/p/:owner/:repo/faq",
      "destination": {
        "service": "go"
      }
    },
    {
      "source": "/p/:owner/:repo/faq/:slug",
      "destination": {
        "service": "go"
      }
    },
    {
      "source": "/p/:owner/:repo/calendar.ics",
      "destination": {
        "service": "go"
      }
    },
    {
      "source": "/p/:owner/:repo/llms.txt",
      "destination": {
        "service": "go"
      }
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": {
        "service": "go"
      }
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": {
        "service": "go"
      }
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": {
        "service": "go"
      }
    },
    {
      "source": "/oauth/(.*)",
      "destination": {
        "service": "go"
      }
    },
    {
      "source": "/mcp",
      "destination": {
        "service": "go"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
