# Copy to .env (git-ignored) and fill in. Never commit .env or paste values into chat.

# --- App (also set these in Vercel) ---
APP_URL=http://localhost:5173           # the origin the browser uses (Vite in dev); every mutation checks Origin against it
NEXT_PUBLIC_NEXCONN_APP_KEY=            # public: Nexconn Console > app > App Key (Go serves it to the UI via GET /api/config; name kept so .env doesn't change)
NEXCONN_APP_SECRET=                     # server only: Nexconn Console > App Secret
NEXCONN_API_BASE_URL=                   # server API base URL for your app's data center (docs: platform-chat-api/prepare-to-use-api/base-url)
NEXCONN_API_BACKUP_URL=                 # the Go SDK needs the backup domain too (e.g. https://api-b.sg-light-api.com for Singapore)
NEXT_PUBLIC_NEXCONN_AREA=               # public: the same data center for the client SDK (choose once in P0)
AUTH_SECRET=                            # 32 random bytes, base64 (`openssl rand -base64 32`): AES-GCM key for the session cookie
# Two GitHub OAuth apps: .env uses the localhost one, Vercel uses the production one
AUTH_GITHUB_ID=                         # GitHub OAuth app client ID
AUTH_GITHUB_SECRET=                     # GitHub OAuth app client secret
DATABASE_URL=                           # local: a Neon `dev` branch (never production). Vercel sets production via the Marketplace
MIGRATE_DATABASE_URL=                   # set only for the moment you migrate production; empty otherwise

# --- Local memory for Claude Code sessions only (never in Vercel) ---
# Same names as in ~/ethglobal/.env: copy those lines here yourself.
SUPERMEMORY_API_KEY=
SUPERMEMORY_CC_API_KEY=
OPENAI_API_KEY=                         # extraction model (OpenAI-compatible, e.g. DeepSeek)
OPENAI_BASE_URL=
